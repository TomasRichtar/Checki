  m_SharedData: {fileID: 11400000, guid: fcfeee5c022f6fe4e8083266430556fc, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 31385337856
    m_Localized: "Odm\u011Bna nen\xED zvolena"
    m_Metadata:
      m_Items: []
  - m_Id: 137144713216
    m_Localized: "Aby jsi mohl vybrat odm\u011Bnu, mus\xED\u0161 ji nejprve zvolit."
    m_Metadata:
      m_Items: []
  - m_Id: 149127839744
    m_Localized: "Pokra\u010Dovat"
    m_Metadata:
      m_Items: []
  - m_Id: 239317958656
    m_Localized: "Odm\u011Bna"
    m_Metadata:
      m_Items: []
  - m_Id: 255046598656
    m_Localized: "Opravdu si chce\u0161 tuto odm\u011Bnu vybrat?"
    m_Metadata:
      m_Items: []
  - m_Id: 346100744192
    m_Localized: "Zru\u0161it"
    m_Metadata:
      m_Items: []
  - m_Id: 267558207488
    m_Localized: "Nem\xE1\u0161 dostatek kreditu"
    m_Metadata:
      m_Items: []
  - m_Id: 290035482624
    m_Localized: "Nem\xE1\u0161 dostate\u010Dn\xFD po\u010Det kreditu, aby sis mohl
      vybrat tuto odm\u011Bnu."
    m_Metadata:
      m_Items: []
  - m_Id: 1556199391232
    m_Localized: "Profil rodi\u010De zalo\u017Een"
    m_Metadata:
      m_Items: []
  - m_Id: 4955549019291648
    m_Localized: "Odm\u011Bny p\u0159idan\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 4955595903221760
    m_Localized: "\xDAkoly p\u0159id\u011Bleny"
    m_Metadata:
      m_Items: []
  - m_Id: 4955670054322176
    m_Localized: "D\xEDt\u011B p\u0159id\xE1no"
    m_Metadata:
      m_Items: []
  - m_Id: 4970074036649984
    m_Localized: "Ke schv\xE1len\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 5428919150198784
    m_Localized: "Profil je \xFAsp\u011B\u0161n\u011B zalo\u017Een"
    m_Metadata:
      m_Items: []
  - m_Id: 20233253884936192
    m_Localized: "Zm\u011Bnit heslo"
    m_Metadata:
      m_Items: []
  - m_Id: 20233400454889472
    m_Localized: "Star\xE9 heslo: "
    m_Metadata:
      m_Items: []
  - m_Id: 20233405811015680
    m_Localized: "Nov\xE9 heslo: "
    m_Metadata:
      m_Items: []
  - m_Id: 20247253863514112
    m_Localized: "\u0160patn\xFD email nebo heslo"
    m_Metadata:
      m_Items: []
  - m_Id: 20247259269971968
    m_Localized: "Zadali jste \u0161patn\xFD email, nebo heslo. Pros\xEDm zkuste
      znova."
    m_Metadata:
      m_Items: []
  - m_Id: 20249430665347072
    m_Localized: "Obnoven\xED \xFA\u010Dtu"
    m_Metadata:
      m_Items: []
  - m_Id: 20249548512706560
    m_Localized: "Kontaktujte n\xE1s na tomto emailu: test@email.com."
    m_Metadata:
      m_Items: []
  - m_Id: 20249550500806656
    m_Localized: "Povinn\xE9 pol\xED\u010Dka nejsou vypln\u011Bna"
    m_Metadata:
      m_Items: []
  - m_Id: 20251722332389376
    m_Localized: "Pros\xEDm vypl\u0148te povinn\xE9 pol\xED\u010Dka a zkuste znova."
    m_Metadata:
      m_Items: []
  - m_Id: 20260913377853440
    m_Localized: "Nutn\xE9 p\u0159ihl\xE1\u0161en\xED rodi\u010De"
    m_Metadata:
      m_Items: []
  - m_Id: 20260914992660480
    m_Localized: "Aby jsi mohl zapnout d\u011Btskou verzi aplikace, je nejd\u0159\xEDv
      nutnost\xED se p\u0159ihl\xE1sit jako rodi\u010D a vytvo\u0159it d\xEDt\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 20288003447865344
    m_Localized: "\u0160patn\xFD form\xE1t hesla"
    m_Metadata:
      m_Items: []
  - m_Id: 20288004337057792
    m_Localized: "Heslo mus\xED obsahovat p\u0159esn\u011B 5 \u010D\xEDslic."
    m_Metadata:
      m_Items: []
  - m_Id: 20288555099504640
    m_Localized: "Profil aktualizov\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 21309887182422016
    m_Localized: "Maxim\xE1ln\xED po\u010Det d\u011Bt\xED je 6. \nV\u011Bt\u0161\xED
      mno\u017Estv\xED bude umo\u017En\u011Bno pozd\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 21309964370198528
    m_Localized: "Maxim\xE1ln\xED po\u010Det d\u011Bt\xED"
    m_Metadata:
      m_Items: []
  references:
    version: 2
